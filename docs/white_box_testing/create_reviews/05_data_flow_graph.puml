@startuml
skinparam nodesep 15
skinparam ranksep 25

usecase "start" as start_node
usecase "1" as n1
note right of n1 : d(userId)\nd(request)
usecase "2" as n2
note right of n2 : d(submittedCount)
usecase "3" as n3
note right of n3 : d(productIdsToUpdate)
usecase "4" as n4
note right of n4 : u(request)
usecase "5" as n5
usecase "6" as n6
usecase "7" as n7
usecase "8" as n8
note right of n8 : u(userId)\nd(review)
usecase "9" as n9
note right of n9 : u(review)
usecase "10" as n10
usecase "11" as n11
usecase "12" as n12
note right of n12 : u(productIdsToUpdate)
usecase "13" as n13
note right of n13 : u(submittedCount)\nd(submittedCount)
usecase "14" as n14
note right of n14 : u(productIdsToUpdate)
usecase "15" as n15
usecase "16" as n16
usecase "17" as n17
usecase "18" as n18
usecase "19" as n19
usecase "20" as n20
usecase "21" as n21
note right of n21 : u(submittedCount)
usecase "Exit" as end_node
note right of end_node : k(userId)\nk(request)\nk(submittedCount)\nk(review)\nk(productIdsToUpdate)

start_node -[hidden]down-> n1
n1 -[hidden]down-> n2
n2 -[hidden]down-> n3
n3 -[hidden]down-> n4
n4 -[hidden]down-> n5
n5 -[hidden]down-> n6
n6 -[hidden]down-> n7
n7 -[hidden]down-> n8
n8 -[hidden]down-> n9
n9 -[hidden]down-> n10
n10 -[hidden]down-> n11
n11 -[hidden]down-> n12
n12 -[hidden]down-> n13
n13 -[hidden]down-> n14
n14 -[hidden]down-> n15
n15 -[hidden]down-> n16
n16 -[hidden]down-> n17
n17 -[hidden]down-> n18
n18 -[hidden]down-> n20
n20 -[hidden]down-> n21
n21 -[hidden]down-> end_node

start_node --> n1
n1 --> n2
n2 --> n3
n3 --> n4

n4 --> n5
n4 --> n14

n5 --> n6

n6 --> n7
n6 --> n4

n7 --> n8
n7 --> n4

n8 --> n9
n9 --> n10
n10 --> n11
n11 --> n12
n12 --> n13
n13 --> n4

n14 --> n15
n14 --> n21

n15 --> n16

n16 --> n17
n16 --> n19

n17 --> n18
n17 --> n19

n18 --> n20
n19 --> n20

n20 --> n14

n21 --> end_node

@enduml
