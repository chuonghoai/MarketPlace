@startuml
skinparam nodesep 15
skinparam ranksep 25

usecase "start" as start_node
usecase "1" as n1
usecase "2" as n2
usecase "3" as n3
usecase "4" as n4
usecase "5" as n5
usecase "6" as n6
usecase "7" as n7
usecase "8" as n8
usecase "9" as n9
usecase "Exit" as end_node

start_node -[hidden]down-> n1
n1 -[hidden]down-> n2
n2 -[hidden]down-> n3
n3 -[hidden]down-> n5
n5 -[hidden]down-> n6
n6 -[hidden]down-> n9
n9 -[hidden]down-> end_node

n4 -[hidden]down-> end_node
n4 -[hidden]right-> n5
n6 -[hidden]right-> n7
n7 -[hidden]down-> n8

start_node --> n1
n1 --> n2
n2 --> n3

n3 --> n4
n3 --> n5
n4 --> end_node

n5 --> n6
n5 --> n7

n6 --> n9

n7 --> n8
n8 --> n9

n9 --> end_node

@enduml
