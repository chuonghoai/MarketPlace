@startuml
skinparam nodesep 15
skinparam ranksep 25

usecase "start" as start_node
usecase "1" as n1
usecase "2" as n2
usecase "3" as n3
usecase "4" as n4
usecase "5" as n5
usecase "6" as n6
usecase "7" as n7
usecase "Exit" as end_node

start_node --> n1
n1 --> n2
n2 --> n3

n3 --> n4 : true
n3 --> n5 : false

n4 --> n6
n5 --> n6

n6 --> n7
n7 --> end_node

@enduml
