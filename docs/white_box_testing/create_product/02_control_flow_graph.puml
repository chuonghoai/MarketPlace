@startuml
skinparam nodesep 20
skinparam ranksep 25

usecase "start" as start_node
usecase "1" as n1
usecase "2" as n2
usecase "3" as n3
usecase "4" as n4
usecase "5" as n5
usecase "6" as n6
usecase "7" as n7
usecase "8" as n8
usecase "9" as n9
usecase "10" as n10
usecase "11" as n11
usecase "12" as n12
usecase "13" as n13
usecase "14" as n14
usecase "Exit" as end_node

start_node -[hidden]down-> n1
n1 -[hidden]down-> n2
n2 -[hidden]down-> n3
n3 -[hidden]down-> n5
n5 -[hidden]down-> n6
n6 -[hidden]down-> n7
n7 -[hidden]down-> n8
n8 -[hidden]down-> n9
n9 -[hidden]down-> n10
n10 -[hidden]down-> n13
n13 -[hidden]down-> n14
n14 -[hidden]down-> end_node

n4 -[hidden]right-> n5

start_node --> n1
n1 --> n2
n2 --> n3

n3 --> n4
n3 --> n5
n4 --> end_node

n5 --> n6
n6 --> n7
n7 --> n8

n8 --> n9
n8 --> n13

n9 --> n10
n9 --> n13

n10 --> n13
n10 --> n11
n11 --> n12
n12 --> n13

n13 --> n14
n14 --> end_node

@enduml