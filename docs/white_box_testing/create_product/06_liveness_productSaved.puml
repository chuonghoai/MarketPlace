@startuml
skinparam nodesep 15
skinparam ranksep 25

usecase "start" as start_node
usecase " " as n1
usecase " " as n2
usecase " " as n3
usecase " " as n4
usecase " " as n5
usecase " " as n6
usecase "d(productSaved)" as n7
usecase " " as n8
usecase " " as n9
usecase " " as n10
usecase " " as n11
usecase "u(productSaved)" as n12
usecase "u(productSaved)" as n13
usecase "u(productSaved)" as n14
usecase "Exit" as end_node
note right of end_node : k(productSaved)

start_node --> n1
n1 --> n2
n2 --> n3
n3 --> n4 : true
n3 --> n5 : false
n4 --> end_node
n5 --> n6
n6 --> n7
n7 --> n8
n8 --> n13 : false
n8 --> n9 : true
n9 --> n13 : false
n9 --> n10 : true
n10 --> n11 : exception
n10 --> n13 : success
n11 --> n12
n12 --> n13
n13 --> n14
n14 --> end_node

@enduml

' Báo cáo liveness biến productSaved:
' - Definition tại n7.
' - Các Use tại n12, n13, n14.
' - Biến được Kill (k) tại Exit node.
' Luồng dữ liệu hoàn toàn hợp lệ, không có biến dị.
