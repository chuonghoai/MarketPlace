@startuml
skinparam nodesep 15
skinparam ranksep 25

' --- Ví dụ DFG Chung ---
' Dùng cho: 05_data_flow_graph.puml
' usecase "1" as n1
' note right of n1 : d(a), u(b)

' --- KHAI BÁO CÁC NÚT (Ví dụ Liveness cho biến 'email') ---
' Dùng cho: 06_liveness_email.puml
usecase "start" as start_node
usecase "d(email)" as n1
usecase " " as n2
usecase " " as n3
usecase "u(email)" as n4
usecase " " as n5
usecase "Exit" as end_node

' LƯU Ý LIVENESS: Node n2, n3, n5 là node trắng. TUYỆT ĐỐI KHÔNG DÙNG:
' note right of n2 :
' Không dùng bất kỳ note nào cho node trắng.

' --- VẼ LUỒNG ĐIỀU KHIỂN (CÁC MŨI TÊN) ---
' Đảm bảo duy nhất 1 node End (Exit)
start_node --> n1
n1 --> n2
n2 --> n3 : True
n2 --> n4 : False
n3 --> end_node
n4 --> n5
n5 --> end_node

@enduml